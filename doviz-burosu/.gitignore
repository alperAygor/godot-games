# Godot 4+ cache ve import çıktısı
.godot/
# Android Gradle şablonu (Godot 4.7.2.stable): kaynaklar depoda, derleme çıktısı/büyük kitaplıklar dışarıda.
# Temiz klonda geri kurmak: docs/store/RELEASE_STATUS.md ("Şablonu yeniden kurma").
/android/build/libs/
/android/build/build/
/android/build/.gradle/
/android/build/local.properties
/android/build/assetPackInstallTime/build/
/android/build/assetPackInstallTime/src/
/android/build/res/mipmap*/
/android/build/res/drawable/splash_icon.webp
/android/build/src/debug/
/android/build/res/values*/godot_project_name_string.xml
/android/.gradle/

# Export ve araç çıktıları
/build/*
!/build/.gitkeep
/tools/screenshots/
/tests/results/

# İmza anahtarları ve gizli bilgiler (asla commit etme)
*.keystore
*.jks
*.p12
.env
.env.*

# İşletim sistemi / editör
.DS_Store
*.tmp
*.translation
