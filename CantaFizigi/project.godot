; CantaFizigi — proje ayarları (Godot 4.7).
; Renderer gl_compatibility: Android düşük segment uyumluluğu için bilinçli seçim (bkz. CLAUDE.md §1).

config_version=5

[application]

config/name="CantaFizigi"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

; Sıra korunur (CLAUDE.md §6): GameManager -> AudioService -> AdManager
GameManager="*res://scripts/autoload/GameManager.gd"
AudioService="*res://scripts/autoload/AudioService.gd"
AdManager="*res://scripts/autoload/AdManager.gd"

[debug]

; CLAUDE.md §2.10 — tipsiz değişken = hata
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unused_parameter=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

; Masaüstünde fare, dokunma olarak taklit edilir; sahneler sadece ScreenTouch/ScreenDrag dinler.
pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
