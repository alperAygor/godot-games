; Çamaşır İpi — studio-kit iskeleti.
; Yeni oyun: new_game.sh bu dosyadaki adı/sürümü değiştirir.

config_version=5

[application]

config/name="Çamaşır İpi"
config/version="0.1.0"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
AudioService="*res://scripts/autoload/AudioService.gd"
AdManager="*res://scripts/autoload/AdManager.gd"
GameData="*res://scripts/autoload/GameData.gd"
Progress="*res://scripts/autoload/Progress.gd"

[debug]

; Tipsiz değişken = hata (GOTCHAS.md yok; CLAUDE.md §2)
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unused_parameter=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/theme/ui_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

; Oyun saf 2B ve fizik gövdesi/_physics_process kullanmıyor (Tween/parçacık boşta işlenir):
; fizik adımı her karede boşa döner. 30 Hz, mobilde kare başına sabit bir yükü yarıya indirir.
common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Mobil doku sıkıştırma (ASTC). Büyük bahçe/çamaşırhane katmanları "high_quality" VRAM
; sıkıştırmalıdır: mobilde ASTC 4x4, masaüstünde BPTC (8 bit/piksel, RGBA8'in 1/4'ü).
textures/vram_compression/import_etc2_astc=true
