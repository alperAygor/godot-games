# Android Gradle şablonu (Godot 4.7.2.stable): kaynaklar depoda (docs/store/RELEASE_STATUS.md),
# üretilenler ve 216 MB'lık godot-lib AAR'ları dışarıda. Şablonu geri kurmak için:
#   godot --headless --path . --install-android-build-template --export-debug "Android (release)" build/x.aab
/android/build/libs/
/android/build/build/
/android/build/.gradle/
/android/build/local.properties
/android/build/assetPackInstallTime/build/
/android/build/assetPackInstallTime/src/
/android/build/res/mipmap*/
/android/build/res/drawable/splash_icon.webp
/android/build/src/debug/
