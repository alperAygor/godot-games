; Kablo Düğümü: Akım Ustası — proje ayarları (Godot 4.7).
; Renderer gl_compatibility: Android düşük segment uyumluluğu için bilinçli seçim (CLAUDE.md §1).

config_version=5

[application]

config/name="Kablo Düğümü: Akım Ustası"
config/version="0.1.0"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

; Sıra korunur (CLAUDE.md §4): GameManager -> AudioService -> AdManager -> GameData
GameManager="*res://scripts/autoload/GameManager.gd"
AudioService="*res://scripts/autoload/AudioService.gd"
AdManager="*res://scripts/autoload/AdManager.gd"
GameData="*res://scripts/autoload/GameData.gd"

[debug]

; CLAUDE.md §2 — tipsiz değişken = hata
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unused_parameter=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/theme/ui_theme.tres"

[input_devices]

; Masaüstünde fare, dokunma olarak taklit edilir; oyun sadece ScreenTouch/ScreenDrag dinler.
pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
